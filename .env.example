# Network Evidence configuration (all optional; sensible defaults exist).
# Copy to .env next to docker-compose.yml or apps/api/.env for local dev.

# Where the SQLite database and working files live (backend).
#NE_DATA_DIR=./data

# Override the database location entirely.
#NE_DATABASE_URL=sqlite:///./data/network_evidence.db

# Batfish analysis engine (local Docker service).
#NE_BATFISH_HOST=localhost
#NE_BATFISH_PORT=9996
# Set false to run without behavioral analysis (verdicts become "unknown").
#NE_BATFISH_ENABLED=true

# Run import/analysis jobs inline instead of in background threads.
#NE_JOBS_SYNC=false

# Backend log level (structured JSON logs on stdout).
#NE_LOG_LEVEL=INFO

# Upload size cap in bytes (default 200 MiB).
#NE_MAX_UPLOAD_BYTES=209715200

# NOTE: There is deliberately no API key or cloud endpoint here. The core
# application requires no internet access and transmits nothing off-machine.
